[global]
    width = 350
    offset = (10, 10)
    origin = top-right
    transparency = 10
    frame_width = 1
    frame_color = "#babbf1"
    corner_radius = 5
    font = Iosevka Comfy 11
    line_height = 4
    padding = 12
    horizontal_padding = 14
    gap_size = 6
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    follow = mouse

[urgency_normal]
    background = "#101010"
    foreground = "#c6d0f5"
    frame_color = "#babbf1"
    timeout = 4

[urgency_low]
    background = "#101010"
    foreground = "#a5adce"
    frame_color = "#3a3a3a"
    timeout = 3

[urgency_critical]
    background = "#101010"
    foreground = "#e78284"
    frame_color = "#e78284"
    timeout = 0
