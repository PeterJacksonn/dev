configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Search";
    drun-display-format: "{name}";
    font: "Iosevka Comfy 12";
}

* {
    bg:         rgba(16, 16, 16, 0.92);
    bg-alt:     rgba(255, 255, 255, 0.04);
    fg:         #c6d0f5;
    fg-dim:     #a5adce;
    accent1:    #babbf1;
    accent2:    #85c1dc;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 22%;
    background-color: @bg;
    border: 1px solid;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    padding: 4px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
    padding: 12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 5px;
    padding: 10px 12px;
    children: [ entry ];
}

entry {
    placeholder: "Search…";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    lines: 8;
    spacing: 4px;
    scrollbar: false;
    fixed-height: true;
    border: 0px;
}

element {
    padding: 8px 10px;
    border-radius: 5px;
    background-color: transparent;
    text-color: @fg-dim;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: transparent;
    text-color: @fg-dim;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: rgba(186, 187, 241, 0.14);
    text-color: @accent1;
}

element-icon {
    size: 22px;
    padding: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
