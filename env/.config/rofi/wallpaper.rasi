* {
    bg:          rgba(16, 16, 16, 0.92);
    fg:          #c6d0f5;
    fg-dim:      #a5adce;
    accent1:     #babbf1;
    accent2:     #85c1dc;

    background-color: transparent;
    text-color: @fg;
}

configuration {
    font: "Iosevka Comfy 12";
    show-icons: true;
    location: 0;
    sidebar-mode: false;
    prompt: "";
    alternate-row-color: false;


    /* free up the keys rofi already claimed */
    kb-remove-char-back: "BackSpace,Shift+BackSpace";
    kb-remove-to-eol: "";
    kb-accept-entry: "Return,KP_Enter";
    kb-mode-complete: "";

    /* now bind vim-style row navigation */
    kb-row-up: "Control+k";
    kb-row-down: "Control+j";
    kb-row-left: "Control+h";
    kb-row-right: "Control+l";

}

window {
    width: 68%;
    height: 78%;
    background-color: @bg;
    border: 1px solid;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
    padding: 20px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 5px;
    padding: 10px 14px;
    children: [ entry ];
}

entry {
    placeholder: "Search wallpapers…";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    columns: 5;
    lines: 3;
    flow: horizontal;
    spacing: 16px;
    scrollbar: true;
    layout: vertical;
    background-color: transparent;
    border: 0px;
    fixed-height: true;
}

element {
    orientation: vertical;
    padding: 4px;
    margin: 0px;
    spacing: 6px;
    border-radius: 5px;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: transparent;
    text-color: @fg-dim;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: rgba(186, 187, 241, 0.12);
    border: 1px solid;
    border-color: @accent1;
}

element-icon {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    size: 190px;
    border-radius: 5px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    font: "Iosevka Comfy 10";
}
